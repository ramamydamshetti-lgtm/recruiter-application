{
  "name": "recruiter-platform-backend",
  "version": "1.0.0",
  "description": "Recruitment Platform Backend with Prisma and PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev:full": "tsx watch src/index.ts",
    "build:full": "tsc",
    "start:full": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "mail:test": "tsx scripts/test-smtp.ts",
    "mail:test-thread": "tsx scripts/test-graph-thread-reply.ts",
    "db:reset": "prisma migrate reset",
    "db:clean-handover": "tsx scripts/clean-database-handover.ts",
    "db:backfill-overall-budget": "tsx scripts/backfill-overall-budget-from-legacy-salary.ts",
    "db:push": "prisma db push",
    "db:ensure-user-ids": "prisma db execute --file prisma/sql/ensure_user_id_generator.sql",
    "db:reset-users": "tsx scripts/reset-all-users.ts",
    "db:migrate-owner-ids": "tsx scripts/migrate-user-ids-to-owner.ts",
    "db:migrate-user-prefix-to-usr": "tsx scripts/migrate-user-prefix-owner-to-usr.ts",
    "db:migrate-user-prefix": "tsx scripts/migrate-user-prefix-owner-to-usr.ts",
    "db:renumber-users": "tsx scripts/renumber-users-sequential.ts",
    "db:ensure-sub-ids": "prisma db execute --file prisma/sql/ensure_submission_pk_generator.sql",
    "db:migrate-sub-ids": "tsx scripts/migrate-submission-ids-to-seq.ts",
    "db:ensure-req-ids": "prisma db execute --file prisma/sql/ensure_requirement_pk_generator.sql",
    "db:ensure-req-display-names": "prisma db execute --file prisma/sql/ensure_requirement_display_name_columns.sql",
    "db:migrate-req-ids": "tsx scripts/migrate-requirement-ids-to-seq.ts",
    "db:ensure-client-ids": "prisma db execute --file prisma/sql/ensure_client_pk_generator.sql",
    "db:migrate-client-ids": "tsx scripts/migrate-client-ids-to-seq.ts",
    "db:ensure-candidate-refs": "prisma db execute --file prisma/sql/ensure_candidate_ref_generator.sql",
    "db:migrate-candidate-refs": "tsx scripts/migrate-candidate-refs-to-seq.ts",
    "db:migrate-candidate-ids": "tsx scripts/migrate-candidate-ids-to-cand.ts",
    "db:migrate-candidate-ids-numeric": "tsx scripts/migrate-candidate-ids-to-numeric.ts",
    "db:normalize-cand-format": "tsx scripts/normalize-candidate-cand-format.ts",
    "db:renumber-candidates": "tsx scripts/renumber-candidate-ids-sequential.ts",
    "db:reset-id-seqs": "tsx scripts/reset-id-sequences.ts",
    "db:clear-requirements": "tsx scripts/clear-all-requirements.ts",
    "pdf:backfill-source-emails": "tsx scripts/backfill-source-email-pdfs.ts",
    "resumes:import": "tsx scripts/import-resumes-to-candidates.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.8.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.7",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.18.0",
    "redis": "^4.6.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^7.0.0",
    "winston": "^3.11.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "prisma": "^5.7.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "recruitment",
    "prisma",
    "postgresql",
    "typescript",
    "express",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT"
}
