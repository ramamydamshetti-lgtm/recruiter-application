# Gemini API (required)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite,gemini-2.5-flash

# Server
PORT=3001
NODE_ENV=production

# Auth — use INTEGRATION_API_KEY for your recruiter backend (recommended)
INTEGRATION_API_KEY=your-secret-service-key-here
JWT_SECRET=change-this-to-a-long-random-string

# Optional JWT login (if you use /api/auth/login directly)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-deploy

# CORS — set your recruiter app origin(s), comma-separated, or *
CORS_ORIGIN=https://your-recruiter-app.com

# Rate limits (per 15 min window per client)
RATE_LIMIT_PARSE=30
RATE_LIMIT_CHAT=60
