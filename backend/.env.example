# =============================================================================
# DEV TEMPLATE — copy to .env in Recruiter Application_Dev\backend only
# Live production: C:\Recruiter Application — ports 3000/8000, DB staffing_db
# =============================================================================

# Database (dev only — never staffing_db here)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Recruiter_dev"

NODE_ENV="development"
PORT="8000"
FRONTEND_URL="http://myapps.taskforge.com"
CORS_EXTRA_ORIGINS=http://192.168.1.10,http://192.168.1.168,http://192.168.1.168:3000,http://myapps.taskforge.com,http://www.myapps.taskforge.com

JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

REDIS_URL="redis://localhost:6379"

MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="recruiter-platform"

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@yourdomain.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-mailbox@yourdomain.com
SMTP_FROM_NAME="MetaForge Recruitment"

MAIL_PROVIDER="graph"
GRAPH_TENANT_ID="your-tenant-id"
GRAPH_CLIENT_ID="your-client-id"
GRAPH_CLIENT_SECRET="your-client-secret"
GRAPH_FROM_EMAIL="your-mailbox@yourdomain.com"

INTERNAL_AUTOMATION_API_KEY="replace-with-strong-random-secret"
INTERNAL_AUTOMATION_ACTOR_NAME="Email Automation"

EMAIL_AUTO_INGEST_ENABLED=true
EMAIL_AUTO_INGEST_INTERVAL_MS=120000
EMAIL_AUTO_INGEST_LOOKBACK_MINUTES=30

# Metaforge AI resume parser (also readable from src/resume/metaforge-resume-parser/metaforge-resume-parser/.env)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3-flash"
GEMINI_FALLBACK_MODELS="gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash"
