# Legacy / alternate API server template — main app uses backend\.env (Express on PORT).
# DEV: frontend 5000, API 8080, DB Recruiter_dev. LIVE: 3000/8000, staffing_db.

DATABASE_URL=postgresql://postgres:password@localhost:5432/Recruiter_dev

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

REDIS_URL=redis://localhost:6379/1

EMAIL_AUTO_INGEST_ENABLED=false

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
