generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  firstName         String
  lastName          String
  role              UserRole           @default(CANDIDATE)
  avatar            String?
  phone             String?
  location          String?
  bio               String?
  isActive          Boolean            @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  emailVerified     Boolean            @default(false)
  auditLogs         AuditLog[]
  candidateProfile  CandidateProfile?
  emailVerification EmailVerification?
  recruiterProfile  RecruiterProfile?
  sessions          Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model CandidateProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  headline          String?
  summary           String?
  experienceYears   Float?
  currentJobTitle   String?
  currentCompany    String?
  desiredJobTitle   String?
  desiredLocation   String?
  salaryMin         Float?
  salaryMax         Float?
  jobType           JobType?
  workMode          WorkMode         @default(ONSITE)
  availability      String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  resumeUrl         String?
  skills            String[]
  languages         String[]
  certifications    String[]
  noticePeriod      Int?
  willingToRelocate Boolean          @default(false)
  isActive          Boolean          @default(true)
  visibility        Visibility       @default(PUBLIC)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  applications      Application[]
  assessments       Assessment[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateSkills   CandidateSkill[]
  education         Education[]
  experiences       Experience[]
  savedJobs         SavedJob[]

  @@map("candidate_profiles")
}

model RecruiterProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  companyName String
  companySize String?
  industry    String?
  website     String?
  logoUrl     String?
  phone       String?
  department  String?
  jobTitle    String?
  bio         String?
  linkedinUrl String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  companyId   String?
  jobs        JobPosting[]
  company     Company?     @relation(fields: [companyId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model Company {
  id                String             @id @default(cuid())
  name              String             @unique
  description       String?
  website           String?
  logoUrl           String?
  industry          String?
  size              String?
  foundedYear       Int?
  location          String?
  phone             String?
  email             String?
  linkedinUrl       String?
  twitterUrl        String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companyReviews    CompanyReview[]
  jobPostings       JobPosting[]
  recruiterProfiles RecruiterProfile[]

  @@map("companies")
}

model Experience {
  id           String           @id @default(cuid())
  candidateId  String
  title        String
  company      String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean          @default(false)
  description  String?
  skills       String[]
  achievements String[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Education {
  id           String           @id @default(cuid())
  candidateId  String
  institution  String
  degree       String
  field        String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean          @default(false)
  gpa          Float?
  description  String?
  achievements String[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("education")
}

model CandidateSkill {
  id          String           @id @default(cuid())
  candidateId String
  skillName   String
  proficiency Proficiency      @default(BEGINNER)
  yearsExp    Float?
  lastUsed    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillName])
  @@map("candidate_skills")
}

model JobPosting {
  id                String           @id @default(cuid())
  recruiterId       String
  companyId         String?
  title             String
  description       String
  requirements      String?
  responsibilities  String?
  benefits          String?
  location          String
  jobType           JobType
  workMode          WorkMode         @default(ONSITE)
  experienceLevel   ExperienceLevel
  salaryMin         Float?
  salaryMax         Float?
  currency          String           @default("USD")
  department        String?
  reportTo          String?
  skills            String[]
  qualifications    String[]
  applicationUrl    String?
  email             String?
  isRemote          Boolean          @default(false)
  isUrgent          Boolean          @default(false)
  isFeatured        Boolean          @default(false)
  isActive          Boolean          @default(true)
  expiresAt         DateTime?
  viewsCount        Int              @default(0)
  applicationsCount Int              @default(0)
  postedAt          DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  applications      Application[]
  company           Company?         @relation(fields: [companyId], references: [id])
  recruiter         RecruiterProfile @relation(fields: [recruiterId], references: [id])
  jobSkills         JobSkill[]
  savedJobs         SavedJob[]

  @@map("job_postings")
}

model JobSkill {
  id         String          @id @default(cuid())
  jobId      String
  skillName  String
  importance SkillImportance @default(REQUIRED)
  yearsExp   Float?
  createdAt  DateTime        @default(now())
  job        JobPosting      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillName])
  @@map("job_skills")
}

model Application {
  id                String                @id @default(cuid())
  jobId             String
  candidateId       String
  status            ApplicationStatus     @default(PENDING)
  stage             ApplicationStage      @default(APPLIED)
  priority          Priority              @default(MEDIUM)
  source            String?
  coverLetter       String?
  resumeUrl         String?
  portfolioUrl      String?
  notes             String?
  salaryExpectation Float?
  availability      String?
  noticePeriod      Int?
  appliedAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  activities        ApplicationActivity[]
  feedback          ApplicationFeedback[]
  candidate         CandidateProfile      @relation(fields: [candidateId], references: [id])
  job               JobPosting            @relation(fields: [jobId], references: [id])
  interviews        Interview[]

  @@unique([jobId, candidateId])
  @@map("applications")
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  type          InterviewType   @default(PHONE)
  title         String
  description   String?
  scheduledFor  DateTime
  duration      Int?
  location      String?
  interviewerId String?
  status        InterviewStatus @default(SCHEDULED)
  notes         String?
  feedback      String?
  rating        Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

model ApplicationActivity {
  id            String         @id @default(cuid())
  applicationId String
  action        ActivityAction
  description   String?
  performedBy   String?
  createdAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_activities")
}

model ApplicationFeedback {
  id             String      @id @default(cuid())
  applicationId  String
  reviewerId     String
  rating         Int
  strengths      String?
  weaknesses     String?
  recommendation String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_feedback")
}

model SavedJob {
  id          String           @id @default(cuid())
  jobId       String
  candidateId String
  savedAt     DateTime         @default(now())
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         JobPosting       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@map("saved_jobs")
}

model Assessment {
  id          String           @id @default(cuid())
  candidateId String
  type        AssessmentType
  title       String
  description String?
  score       Float?
  maxScore    Float?
  status      AssessmentStatus @default(PENDING)
  results     Json?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

model CompanyReview {
  id             String   @id @default(cuid())
  companyId      String
  reviewerId     String
  rating         Int
  title          String?
  pros           String?
  cons           String?
  advice         String?
  isCurrent      Boolean  @default(false)
  jobTitle       String?
  department     String?
  yearsAtCompany Float?
  isRecommended  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_reviews")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum Visibility {
  PUBLIC
  PRIVATE
  CONFIDENTIAL
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillImportance {
  NICE_TO_HAVE
  PREFERRED
  REQUIRED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  WITHDRAWN
  HIRED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_ASSESSMENT
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  BEHAVIORAL
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ActivityAction {
  APPLIED
  VIEWED
  SHORTLISTED
  REJECTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER_EXTENDED
  OFFER_ACCEPTED
  OFFER_DECLINED
  WITHDRAWN
  NOTE_ADDED
  STATUS_CHANGED
}

enum AssessmentType {
  TECHNICAL
  BEHAVIORAL
  APTITUDE
  PERSONALITY
  CODING
  LANGUAGE
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}
